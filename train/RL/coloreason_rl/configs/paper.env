# Parameters directly supported by ms-swift GRPO 4.5.0.dev0.
LEARNING_RATE=1e-6
EPSILON=0.2
KL_BETA=0.02
GENERATION_BATCH_SIZE=64
OPTIMIZATION_BATCH_SIZE=16
NUM_ITERATIONS=4
MAX_COMPLETION_LENGTH=32768
NUM_GENERATIONS=8
TEMPERATURE=0.6
TOP_P=0.95

# Manuscript correction: gamma=0.99 is a PPO-only argument in this ms-swift version.
# The reported entropy coefficient=0.01 also has no GRPO training argument here.
